<mxfile host="app.diagrams.net" modified="2026-10-15T01:26:00.000Z" agent="Predii India" version="24.7.17">
  <diagram id="predii-rag-architecture" name="Predii India RAG Architecture">
    <mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="PREDII INDIA | Vehicle Manual Specification Extraction Architecture" style="text;html=1;strokeColor=none;fillColor=none;fontSize=24;fontStyle=1;fontColor=#10233f;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1300" height="40" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Retrieval-Augmented Generation (RAG) pipeline with conditional OCR and auditable structured output" style="text;html=1;strokeColor=none;fillColor=none;fontSize=14;fontColor=#5b6b82;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="52" y="70" width="1100" height="30" as="geometry"/>
        </mxCell>

        <mxCell id="input" value="1. INPUT&lt;br&gt;&lt;b&gt;Service manual PDF&lt;/b&gt;&lt;br&gt;data/sample-service-manual.pdf" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f2ff;strokeColor=#3976b8;strokeWidth=2;fontColor=#10233f;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="180" width="190" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="extract" value="2. PDF TEXT EXTRACTION&lt;br&gt;&lt;b&gt;PyMuPDF&lt;/b&gt;&lt;br&gt;Read text and preserve page number" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f2ff;strokeColor=#3976b8;strokeWidth=2;fontColor=#10233f;fontSize=15;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="300" y="180" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="condition" value="CONDITION&lt;br&gt;Is extracted page text &lt; 100 characters?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff3d9;strokeColor=#d99024;strokeWidth=2;fontColor=#4d3410;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="570" y="170" width="220" height="120" as="geometry"/>
        </mxCell>
        <mxCell id="keep" value="3A. KEEP PDF TEXT&lt;br&gt;Text is sufficient&lt;br&gt;method = pdf_text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f8f1;strokeColor=#31966e;strokeWidth=2;fontColor=#123b2d;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="115" width="190" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="ocr" value="3B. OCR FALLBACK&lt;br&gt;&lt;b&gt;PyMuPDF + Pillow + Tesseract&lt;/b&gt;&lt;br&gt;Render page image and extract OCR text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff0e8;strokeColor=#c86b3c;strokeWidth=2;fontColor=#4e2819;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="250" width="220" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="compare" value="OCR comparison&lt;br&gt;Normalize PDF/OCR text and compare" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3d9;strokeColor=#d99024;strokeWidth=2;fontColor=#4d3410;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1130" y="250" width="210" height="105" as="geometry"/>
        </mxCell>
        <mxCell id="merge" value="Merge decision&lt;br&gt;Use OCR, PDF text, or combined text&lt;br&gt;method = ocr / combined" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff3d9;strokeColor=#d99024;strokeWidth=2;fontColor=#4d3410;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1130" y="390" width="210" height="105" as="geometry"/>
        </mxCell>

        <mxCell id="clean" value="4. TEXT CLEANING&lt;br&gt;Normalize whitespace and remove noise" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f2ff;strokeColor=#3976b8;strokeWidth=2;fontColor=#10233f;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="560" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="chunk" value="5. CHUNKING&lt;br&gt;&lt;b&gt;chunk_size = 1000 characters&lt;/b&gt;&lt;br&gt;&lt;b&gt;overlap = 200 characters&lt;/b&gt;&lt;br&gt;Preserve page and method metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f2ff;strokeColor=#3976b8;strokeWidth=2;fontColor=#10233f;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="560" width="220" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="embed" value="6. EMBEDDING&lt;br&gt;&lt;b&gt;Sentence-Transformers&lt;/b&gt;&lt;br&gt;all-MiniLM-L6-v2&lt;br&gt;Local semantic vector" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9ff;strokeColor=#7158c9;strokeWidth=2;fontColor=#261b5e;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="270" y="560" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="chroma" value="7. VECTOR DATABASE&lt;br&gt;&lt;b&gt;ChromaDB Cloud&lt;/b&gt;&lt;br&gt;Store chunk text, embedding, page, method&lt;br&gt;Upload batches of 250" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9ff;strokeColor=#7158c9;strokeWidth=2;fontColor=#261b5e;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="560" width="175" height="110" as="geometry"/>
        </mxCell>

        <mxCell id="query" value="8. USER QUERY&lt;br&gt;Example: What is brake caliper torque?" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f8f1;strokeColor=#31966e;strokeWidth=2;fontColor=#123b2d;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="50" y="790" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="qembed" value="Query embedding&lt;br&gt;Same all-MiniLM-L6-v2 model" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9ff;strokeColor=#7158c9;strokeWidth=2;fontColor=#261b5e;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="790" width="190" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="retrieve" value="9. SEMANTIC RETRIEVAL&lt;br&gt;ChromaDB returns top_k closest chunks&lt;br&gt;default top_k = 5" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eee9ff;strokeColor=#7158c9;strokeWidth=2;fontColor=#261b5e;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="580" y="790" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="llm" value="10. LLM EXTRACTION&lt;br&gt;&lt;b&gt;Groq&lt;/b&gt;&lt;br&gt;Use retrieved context only&lt;br&gt;temperature = 0" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe7f2;strokeColor=#c34d82;strokeWidth=2;fontColor=#541d38;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="860" y="790" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="validate" value="11. VALIDATION&lt;br&gt;&lt;b&gt;Pydantic schema&lt;/b&gt;&lt;br&gt;Check fields and confidence 0-1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe7f2;strokeColor=#c34d82;strokeWidth=2;fontColor=#541d38;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="790" width="210" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="output" value="12. OUTPUT&lt;br&gt;&lt;b&gt;JSON or CSV&lt;/b&gt;&lt;br&gt;Value + unit + source page + evidence text" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e7f8f1;strokeColor=#31966e;strokeWidth=2;fontColor=#123b2d;fontSize=14;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="930" width="210" height="70" as="geometry"/>
        </mxCell>

        <mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#3976b8;endArrow=block;" edge="1" parent="1" source="input" target="extract"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#3976b8;endArrow=block;" edge="1" parent="1" source="extract" target="condition"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e3" value="NO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#31966e;endArrow=block;fontColor=#31966e;" edge="1" parent="1" source="condition" target="keep"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e4" value="YES" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#c86b3c;endArrow=block;fontColor=#c86b3c;" edge="1" parent="1" source="condition" target="ocr"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#c86b3c;endArrow=block;" edge="1" parent="1" source="ocr" target="compare"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#d99024;endArrow=block;" edge="1" parent="1" source="compare" target="merge"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#3976b8;endArrow=block;" edge="1" parent="1" source="keep" target="clean"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#3976b8;endArrow=block;" edge="1" parent="1" source="merge" target="clean"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeWidth=2;strokeColor=#3976b8;endArrow=block;" edge="1" parent="1" source="clean" target="chunk"><mxGeometry relative="1" as="geometry"/></mxCell>
